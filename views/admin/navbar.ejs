<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Cake Shop Admin Panel</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/feather-icons"></script>
  <style>
    :root {
      --main-orange: #f08632;
      --dark-bg: #111;
    }

    .sidebar-link {
      display: block;
      padding: 0.5rem 1rem;
      border-radius: 9999px;
      color: #ccc;
      transition: all 0.3s ease;
    }

    .sidebar-link:hover {
      background-color: var(--main-orange);
      color: white;
    }

    .sidebar-link.active {
      background-color: var(--main-orange);
      color: white;
      font-weight: 600;
      box-shadow: 0 0 10px rgba(240, 134, 50, 0.5);
    }

    /* Make sure main content fills the screen */
    body, html {
      height: 100%;
      margin: 0;
    }

    main {
      min-height: 100vh;
    }
  </style>
</head>

<!-- Navbar -->
<header class="sticky top-0 z-50 bg-white border-b shadow-sm flex justify-between items-center px-6 py-3 mb-6">
  <!-- Left: Logo Image -->
  <div class="flex items-center gap-2">
    <img src="http://localhost:3000/img/logo.png" alt="Logo" class="h-10 w-auto object-contain" />
    <span class="text-lg font-semibold text-[var(--main-orange)] hidden sm:inline">Admin Panel</span>
  </div>

  <!-- Right: Search + Profile -->
  <div class="flex items-center space-x-4">
    <input type="text" placeholder="Search..." class="hidden sm:block px-4 py-2 rounded-full border border-gray-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-[var(--main-orange)]" />
    
    <div class="relative group cursor-pointer">
      <div class="w-10 h-10 bg-[var(--main-orange)] text-white rounded-full flex items-center justify-center font-semibold text-lg">
        A
      </div>
      <div class="absolute right-0 mt-2 w-40 bg-white text-gray-800 rounded-lg shadow-lg p-2 opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all duration-300">
        <p class="px-2 py-1 hover:bg-gray-100 rounded">Profile</p>
        <p class="px-2 py-1 hover:bg-gray-100 rounded">Settings</p>
        <p class="px-2 py-1 hover:bg-gray-100 rounded">Logout</p>
      </div>
    </div>
  </div>
</header>

<body class="bg-gray-100 text-gray-800 font-sans h-full">

  <div class="flex h-full">

    <!-- Sidebar -->
    <aside class="w-64 bg-[var(--dark-bg)] text-white shadow-lg">
      <div class="text-center text-2xl font-bold py-6 border-b border-gray-700">
        🎂 Admin Panel
      </div>
      <nav class="p-4 space-y-2 text-lg" id="sidebar-links">
        <a href="#" class="sidebar-link active">Dashboard</a>

        <!-- Sidebar Item - Home with Submenu -->
        <div>
          <button onclick="document.getElementById('homeSubmenu').classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-90')" class="w-full sidebar-link flex justify-between items-center text-left text-white">
            <span class="flex items-center gap-2">
              <i data-feather="home"></i> Home
            </span>
            <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <ul id="homeSubmenu" class="hidden ml-4 mt-2 space-y-1">
            <li><a href="/admin/home_slider" class="block px-4 py-2 text-sm text-gray-300 hover:bg-[var(--main-orange)] hover:text-white rounded">📸 Add Slider</a></li>
            <li><a href="/admin/about" class="block px-4 py-2 text-sm text-gray-300 hover:bg-[var(--main-orange)] hover:text-white rounded">🧾 About Us</a></li>
            <li><a href="/admin/card" class="block px-4 py-2 text-sm text-gray-300 hover:bg-[var(--main-orange)] hover:text-white rounded">🃏 Cards</a></li>
            <li><a href="/admin/doctor" class="block px-4 py-2 text-sm text-gray-300 hover:bg-[var(--main-orange)] hover:text-white rounded">👨‍⚕️ Doctor</a></li>
            <li><a href="/admin/countdown" class="block px-4 py-2 text-sm text-gray-300 hover:bg-[var(--main-orange)] hover:text-white rounded">⏳ Countdown</a></li>
            <li><a href="/admin/contactform" class="block px-4 py-2 text-sm text-gray-300 hover:bg-[var(--main-orange)] hover:text-white rounded">📩 Contact Form</a></li>
            <li><a href="/admin/youtube" class="block px-4 py-2 text-sm text-gray-300 hover:bg-[var(--main-orange)] hover:text-white rounded">🎥 YouTube Video</a></li>
          </ul>
        </div>

        <a href="#" class="sidebar-link">Orders</a>
        <a href="#" class="sidebar-link">Categories</a>
        <a href="#" class="sidebar-link">Logout</a>
      </nav>
    </aside>
 
  

    <!-- Main Content -->
    <main class="flex-1 p-6">
      <!-- Topbar -->
      <div class="flex justify-between items-center mb-6">
         <p class="text-sm text-gray-600">Welcome, Admin 👩‍🍳</p>
      </div>

      <!-- Dashboard Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <div class="bg-white p-4 rounded-xl shadow border-l-4 border-[var(--main-orange)] hover:scale-105 transition">
          <h2 class="text-sm text-gray-500">Total Cakes</h2>
          <p class="text-2xl font-bold text-[var(--main-orange)]">132</p>
        </div>
        <div class="bg-white p-4 rounded-xl shadow border-l-4 border-[var(--main-orange)] hover:scale-105 transition">
          <h2 class="text-sm text-gray-500">Orders Today</h2>
          <p class="text-2xl font-bold text-[var(--main-orange)]">24</p>
        </div>
        <div class="bg-white p-4 rounded-xl shadow border-l-4 border-[var(--main-orange)] hover:scale-105 transition">
          <h2 class="text-sm text-gray-500">Revenue</h2>
          <p class="text-2xl font-bold text-[var(--main-orange)]">$560</p>
        </div>
        <div class="bg-white p-4 rounded-xl shadow border-l-4 border-[var(--main-orange)] hover:scale-105 transition">
          <h2 class="text-sm text-gray-500">Pending Orders</h2>
          <p class="text-2xl font-bold text-[var(--main-orange)]">7</p>
        </div>
      </div>

      <!-- Product Management Section -->
      <div>
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-2xl font-semibold">Manage Cakes</h2>
          <button class="bg-[var(--main-orange)] text-white px-4 py-2 rounded hover:bg-orange-600 transition">+ Add Cake</button>
        </div>

        <!-- Search -->
        <div class="mb-4">
          <input type="text" id="searchInput" placeholder="Search Cakes..." class="w-full px-4 py-2 border rounded shadow-sm focus:outline-none focus:ring-2 focus:ring-[var(--main-orange)]" />
        </div>

        <!-- Table -->
        <div class="overflow-x-auto bg-white shadow rounded-lg">
          <table class="min-w-full text-sm">
            <thead class="bg-[var(--main-orange)] text-white">
              <tr>
                <th class="px-6 py-3 text-left">Image</th>
                <th class="px-6 py-3 text-left">Cake Name</th>
                <th class="px-6 py-3 text-left">Price</th>
                <th class="px-6 py-3 text-left">Category</th>
                <th class="px-6 py-3 text-left">Actions</th>
              </tr>
            </thead>
            <tbody id="productTable">
              <tr class="border-b hover:bg-gray-50">
                <td class="px-6 py-3">
                  <img src="https://via.placeholder.com/50" class="w-12 h-12 rounded-full object-cover" />
                </td>
                <td class="px-6 py-3">Chocolate Dream</td>
                <td class="px-6 py-3">$22</td>
                <td class="px-6 py-3">Birthday</td>
                <td class="px-6 py-3 space-x-2">
                  <button class="px-3 py-1 bg-green-600 text-white rounded hover:bg-green-700">Edit</button>
                  <button class="px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700">Delete</button>
                </td>
              </tr>
              <tr class="border-b hover:bg-gray-50">
                <td class="px-6 py-3">
                  <img src="https://via.placeholder.com/50" class="w-12 h-12 rounded-full object-cover" />
                </td>
                <td class="px-6 py-3">Strawberry Bliss</td>
                <td class="px-6 py-3">$18</td>
                <td class="px-6 py-3">Wedding</td>
                <td class="px-6 py-3 space-x-2">
                  <button class="px-3 py-1 bg-green-600 text-white rounded hover:bg-green-700">Edit</button>
                  <button class="px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700">Delete</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>


   
  <!-- Footer -->
<footer class="bg-gradient-to-r from-[var(--dark-bg)] via-black to-[var(--dark-bg)] text-gray-400 text-sm text-center py-4 border-t border-gray-700 mt-10">
  <p>&copy; 2025 Udayanraje Cake Admin Panel | Crafted with ❤️ for Excellence</p>
</footer>
  </div>

<script>
  feather.replace();
</script>
<!-- Sidebar Active Highlight Script -->
<script>
  const links = document.querySelectorAll("#sidebar-links .sidebar-link");

  links.forEach(link => {
    link.addEventListener("click", () => {
      links.forEach(l => l.classList.remove("active"));
      link.classList.add("active");
    });
  });
</script>

<!-- Search Filter Script -->
<script>
  document.getElementById("searchInput").addEventListener("input", function () {
    const filter = this.value.toLowerCase();
    const rows = document.querySelectorAll("#productTable tr");
    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      row.style.display = text.includes(filter) ? "" : "none";
    });
  });
</script>

</body>
</html>
